# Sao chép thành .env và chỉnh. KHÔNG commit .env lên Git.
ORA_HOST=localhost
ORA_PORT=1521
ORA_SERVICE=XEPDB1
ORA_ROOT_SERVICE=XE
ORA_SYS_PASSWORD=oracle_sys_pwd

VSS_USER=VSS
VSS_PASSWORD=vss_pwd
MIRROR_USER=MIRROR
MIRROR_PASSWORD=mirror_pwd
C360_USER=C360
C360_PASSWORD=c360_pwd

# Khi chạy TRONG docker-compose, Kafka Connect gọi Oracle bằng tên service 'oracle'
CDC_ORA_HOST=oracle
CDC_ORA_PORT=1521
DBZ_USER=c##dbzuser
DBZ_PASSWORD=dbz
KAFKA_CONNECT_URL=http://localhost:8083
TOPIC_PREFIX=hgd

# Full Load Spark
FULLLOAD_PARTITIONS=8
FULLLOAD_FETCHSIZE=10000
FULLLOAD_BATCHSIZE=10000
SPARK_OJDBC_PACKAGE=com.oracle.database.jdbc:ojdbc11:23.5.0.24.07

# API
API_SYNC_LAG_SECONDS=120
API_AUDIT_FLUSH_SECONDS=2
